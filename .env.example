# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/privacychatbox

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key

# Anthropic API (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Gemini API (Optional)
GOOGLE_API_KEY=your_gemini_api_key

# SerpAPI for web search (Optional)
SERPAPI_KEY=your_serpapi_key

# Azure AD Authentication (Optional)
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_REDIRECT_URI=http://localhost:5000/

# Microsoft DLP Integration (Optional)
MS_CLIENT_ID=your_ms_client_id
MS_CLIENT_SECRET=your_ms_client_secret
MS_TENANT_ID=your_ms_tenant_id
# Optional Purview settings (see README > Microsoft Purview DLP)
# MS_PURVIEW_APPLICATION_ID=        # defaults to MS_CLIENT_ID
# MS_PURVIEW_PROCESS_CONTENT=true   # evaluate prompts/files with Purview DLP policies
# MS_PURVIEW_FAIL_CLOSED=false      # block when Purview cannot be reached
# MS_DLP_LABEL_LEVELS={"Project Falcon": "secret"}
# MS_DLP_UNKNOWN_LABEL_LEVEL=confidential

# Encryption at rest for conversation content (Fernet key). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a secure backup: data encrypted with a lost key cannot be recovered.
DATA_ENCRYPTION_KEY=

# Optional: replace the built-in model lists (comma-separated, first = default)
# OPENAI_MODELS=gpt-5.6-terra,gpt-6.1-sol
# CLAUDE_MODELS=claude-sonnet-5-5,claude-opus-5-5
# GEMINI_MODELS=gemini-3.8-flash

# Application Settings
DEBUG_MODE=false
LOG_LEVEL=INFO
ALLOW_SELF_REGISTRATION=false

# Bootstrap Admin Account
# Leave DEFAULT_ADMIN_PASSWORD empty to generate a random temporary password, printed
# once to the server log. Weak values (fewer than 8 characters, "admin") are ignored.
# The bootstrap password must be changed at first login either way.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
